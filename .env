# FX Options Hedger - server settings, read by api/app.py when the server starts.
# Anything already set in the shell (or by systemd on EC2) wins over this file.
# Lines starting with # are comments.

# SQLite file for saved sessions. A relative path counts from the project folder.
FX_DB_PATH=sessions.db

# Key for GET /sessions, the admin list of every session (send it as the X-Admin-Key header).
# Leave it empty to switch the list off.
FX_ADMIN_KEY=fx-desk-admin-2026

# Unload a session from memory after this many idle minutes (it stays saved in the database).
FX_IDLE_MINUTES=30

# Most sessions kept in memory at once; the least recently used are unloaded first.
FX_MAX_LOADED=200